{
    "name": "@animeworldid/general",
    "version": "0.0.0",
    "description": "A useful Discord bot for Anime World Indonesia",
    "license": "AGPL-3.0",
    "author": "Anime World Indonesia <dev@animeworld.moe>",
    "type": "module",
    "main": "dist",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/types/index.d.ts"
        }
    },
    "scripts": {
        "build": "pnpm run compile && pnpm run lint",
        "build:clean": "rimraf dist && pnpm run build",
        "compile": "tsc -b tsconfig.json && tsconfig-replace-paths --project tsconfig.json",
        "lint": "eslint",
        "start": "node --env-file=.env dist/index.js",
        "start:dev": "pnpm run compile && pnpm run start"
    },
    "dependencies": {
        "@animeworldid/core": "workspace:^",
        "@animeworldid/database": "workspace:*",
        "@animeworldid/logger": "workspace:*",
        "@animeworldid/utilities": "workspace:^",
        "@discordjs/builders": "^1.14.1",
        "@nezuchan/core": "^0.19.4",
        "@nezuchan/decorators": "^0.3.0",
        "@nezuchan/framework": "^0.19.7",
        "@nezuchan/kanao-schema": "^0.10.2",
        "@nezuchan/utilities": "^0.7.0",
        "@sapphire/discord-utilities": "^3.5.0",
        "@sapphire/pieces": "^4.4.1",
        "@sapphire/result": "^2.8.0",
        "@sapphire/stopwatch": "^1.5.4",
        "@sapphire/time-utilities": "^1.7.14",
        "@sapphire/utilities": "^3.18.2",
        "@skyra/start-banner": "^2.0.2",
        "@trpc/client": "^10.45.4",
        "@trpc/server": "^10.45.4",
        "common-tags": "^1.8.2",
        "discord-api-types": "^0.38.53",
        "drizzle-orm": "^0.45.2",
        "got": "^14.6.6",
        "gradient-string": "^2.0.2",
        "pino": "^8.21.0",
        "source-map-support": "^0.5.21",
        "tslib": "^2.8.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@hazmi35/eslint-config": "^13.3.1",
        "@types/amqplib": "^0.10.8",
        "@types/common-tags": "^1.8.4",
        "@types/gradient-string": "^1.1.6",
        "@types/ms": "^0.7.34",
        "@types/node": "^20.19.43",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.1",
        "rimraf": "^5.0.10",
        "tsconfig-replace-paths": "^0.0.18",
        "typescript": "~5.9.3"
    },
    "engines": {
        "node": ">=20.20.2",
        "pnpm": ">=8.15.9"
    }
}